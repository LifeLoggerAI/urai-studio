rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }

    function membershipPath(studioId) {
      return /databases/(default)/documents/memberships/$(request.auth.uid + "_" + studioId);
    }

    function isStudioMember(studioId) {
      return isSignedIn()
        && firestore.exists(membershipPath(studioId))
        && firestore.get(membershipPath(studioId)).data.uid == request.auth.uid
        && firestore.get(membershipPath(studioId)).data.studioId == studioId
        && firestore.get(membershipPath(studioId)).data.status == "active";
    }

    function canEdit(studioId) {
      return isStudioMember(studioId)
        && firestore.get(membershipPath(studioId)).data.role in ["owner", "admin", "editor"];
    }

    match /studios/{studioId}/uploads/{allPaths=**} {
      allow read: if isStudioMember(studioId);
      allow write: if canEdit(studioId);
    }

    // Generated outputs are worker-owned. Active members may read them, but
    // browser clients cannot impersonate the render/export worker.
    match /studios/{studioId}/outputs/{allPaths=**} {
      allow read: if isStudioMember(studioId);
      allow write: if false;
    }

    match /user-uploads/{uid}/studio/{allPaths=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /generated/{uid}/studio/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /public/studio-assets/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
