{
  "schemaVersion": "1.0.0",
  "contractId": "urai-source-evidence-packet",
  "purpose": "Normalize source-media pixels, technical metadata, provenance, device/time/place evidence and same-event relationships before any Life Movie or reconstruction canon is built.",
  "privacy": {
    "preciseGpsMayEnterPublicRepo": false,
    "privateNamesMayEnterPublicRepo": false,
    "exactPrivateAddressesMayEnterPublicRepo": false,
    "rawPrivateMediaMayEnterPublicRepo": false,
    "publicSchemasMayDescribeFields": true
  },
  "sourceClasses": [
    "camera-original",
    "scan",
    "screenshot",
    "screen-recording",
    "exported-copy",
    "edited-derivative",
    "transcode",
    "generated",
    "document-photo",
    "unknown"
  ],
  "evidenceStates": [
    "confirmed-source",
    "source-supported",
    "metadata-only",
    "label-only",
    "inferred",
    "conflicting",
    "unknown"
  ],
  "timestampKinds": [
    "exif-original",
    "exif-digitized",
    "file-created",
    "file-modified",
    "cloud-created",
    "cloud-modified",
    "embedded-media",
    "filename-only",
    "unknown"
  ],
  "requiredFields": [
    "sourceAssetKey",
    "sourceClass",
    "mimeType",
    "byteSize",
    "sha256",
    "dimensions",
    "orientation",
    "fileName",
    "containerOrCodec",
    "colorProfile",
    "softwareHistory",
    "device",
    "timestamps",
    "gps",
    "locationEvidence",
    "folderProvenance",
    "batchKey",
    "sameEventClusterKey",
    "neighborSourceKeys",
    "identityLabels",
    "confirmedIdentityKeys",
    "visibleFacts",
    "metadataFacts",
    "contradictions",
    "privacyClass",
    "sourceConfidence",
    "derivativeOfSourceKey"
  ],
  "rules": {
    "sha256RequiredForOriginal": true,
    "sourceBytesImmutable": true,
    "derivativesStoredSeparately": true,
    "equalByteSizeIsNotDeduplication": true,
    "metadataTimestampIsNotCaptureTimeUnlessProven": true,
    "fileNameLabelIsNotIdentityProof": true,
    "folderLabelIsNotIdentityProof": true,
    "facialResemblanceIsNotIdentityProof": true,
    "generatedMediaIsNeverSourceTruth": true,
    "preciseGpsPrivateByDefault": true,
    "gpsPresenceMayBeRecordedWithoutCoordinates": true,
    "sameEventClusteringRequiresEvidence": true,
    "sourceSpecificityCapsCanonSpecificity": true,
    "deviceMetadataMaySupportEraAndCaptureContext": true,
    "neighboringFilesMaySupportSequenceButNotOverrideContradictions": true
  },
  "sameEventClusterSignals": [
    "capture-time proximity",
    "shared device",
    "shared GPS region",
    "same visible people",
    "same wardrobe",
    "same vehicle or object",
    "same architecture",
    "same environment",
    "same batch or album",
    "sequential filenames",
    "continuous video/photo burst",
    "matching testimony"
  ],
  "sameEventClusterHardStops": [
    "conflicting identity",
    "conflicting place",
    "conflicting era",
    "different source medium with no bridge",
    "generated derivative mistaken for original",
    "unresolved duplicate provenance"
  ],
  "outputUse": {
    "feedsSceneTruthPacket": true,
    "feedsEnvironmentReconstruction": true,
    "feedsPersonEraIdentityPack": true,
    "feedsVehicleObjectLock": true,
    "feedsContinuityState": true,
    "feedsCapturedRealityTruth": true
  }
}
