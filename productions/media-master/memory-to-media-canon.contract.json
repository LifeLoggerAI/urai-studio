{
  "schemaVersion": "1.1.0",
  "contractId": "urai-memory-to-media-canon-lock",
  "state": "fail-closed",
  "purpose": "Require UrAi memory/context truth to constrain generation and require post-generation validation before a shot may advance.",
  "providerRole": "renderer-only",
  "privateCanonStorage": "private-canon-broker",
  "publicRepoPolicy": {
    "privateDriveIdentifiersAllowed": false,
    "privateNamesAllowed": false,
    "exactPrivateAddressesAllowed": false,
    "rawPrivateMediaAllowed": false,
    "abstractKeysAndSchemasAllowed": true
  },
  "truthClasses": [
    "RECORDED_SOURCE_TRUTH",
    "SOURCE_SUPPORTED_RECONSTRUCTION",
    "ATTRIBUTED_RECOLLECTION",
    "INTERPRETIVE_RECREATION",
    "UNKNOWN"
  ],
  "sceneTruthPacket": {
    "requiredFields": [
      "sceneId",
      "projectId",
      "memoryKey",
      "dateOrDateRange",
      "dateConfidence",
      "locationKey",
      "locationConfidence",
      "environmentClass",
      "persons",
      "personIdentityReferenceKeys",
      "personAgeEraKeys",
      "roleBindings",
      "vehicles",
      "objects",
      "architecture",
      "weather",
      "season",
      "timeOfDay",
      "vegetationLandscape",
      "cameraSourceReferenceKeys",
      "voiceReferenceKeys",
      "dialogueSourceKeys",
      "ambienceSourceKeys",
      "musicStatus",
      "knownFacts",
      "attributedRecollections",
      "reconstructableDetails",
      "interpretiveDetails",
      "unknownDetails",
      "prohibitedInventions",
      "provenanceKeys",
      "confidence",
      "continuityDependencies",
      "unresolvedContradictions",
      "criticalUnknownFields",
      "detailBindings"
    ],
    "unresolvedCriticalFieldsBlockGeneration": true,
    "unresolvedContradictionsBlockGeneration": true,
    "unknownMustRemainUnknown": true,
    "identityMustUsePrivateCanonBroker": true,
    "eraSpecificIdentityRequiredForIdentifiablePeople": true,
    "environmentClassRequired": true,
    "roleBindingRequiredWhenOccupationOrServiceIsDepicted": true,
    "vehicleSpecificityCannotExceedEvidence": true,
    "detailBindingContract": {
      "requiredKeys": [
        "identity",
        "ageEra",
        "role",
        "date",
        "season",
        "timeOfDay",
        "place",
        "environment",
        "weather",
        "vehicle",
        "wardrobe",
        "uniform",
        "architecture",
        "objects",
        "vegetation",
        "voice",
        "dialogue",
        "ambience",
        "continuity"
      ],
      "exactnessStates": [
        "exact-required",
        "source-faithful",
        "approximation-allowed",
        "not-applicable"
      ],
      "truthStates": [
        "confirmed-source",
        "source-supported",
        "attributed-recollection",
        "reconstruction",
        "interpretive",
        "unknown"
      ],
      "exactRequiredAcceptsOnly": [
        "confirmed-source",
        "source-supported"
      ],
      "unknownMayCarryConcreteValue": false,
      "nonUnknownRequiresEvidence": true,
      "duplicateKeysAllowed": false
    }
  },
  "preGeneration": {
    "sceneTruthPacketRequired": true,
    "privateCanonResolutionRequired": true,
    "continuityStateRequiredForDependentShots": true,
    "providerAuthorizationRequired": true,
    "providerAuthorizationMustBeBounded": true,
    "rawNarrativeOnlyPromptingAllowed": false,
    "criticalContradictionMayProceed": false,
    "exactDimensionsMustBeSourceLocked": true,
    "criticalExactDimensionMayUseReconstruction": false
  },
  "failureCodes": [
    "IDENTITY_FAIL",
    "AGE_FAIL",
    "ROLE_FAIL",
    "ERA_FAIL",
    "EYEWEAR_FAIL",
    "WARDROBE_FAIL",
    "UNIFORM_FAIL",
    "VEHICLE_FAIL",
    "OBJECT_FAIL",
    "ENVIRONMENT_FAIL",
    "GEOGRAPHY_FAIL",
    "ARCHITECTURE_FAIL",
    "TIME_OF_DAY_FAIL",
    "WEATHER_FAIL",
    "VOICE_FAIL",
    "DIALOGUE_FAIL",
    "CONTINUITY_FAIL",
    "PROVENANCE_FAIL",
    "TRUTH_CLASS_FAIL",
    "ANACHRONISM_FAIL",
    "GENERICIZATION_FAIL",
    "VISUAL_QUALITY_FAIL",
    "AUDIO_QUALITY_FAIL",
    "MOTION_FAIL",
    "LIPSYNC_FAIL"
  ],
  "qualityDimensions": [
    "PHOTOREALISM",
    "IDENTITY_FIDELITY",
    "BIOGRAPHICAL_FIDELITY",
    "PLACE_FIDELITY",
    "ERA_FIDELITY",
    "OBJECT_VEHICLE_FIDELITY",
    "ROLE_FIDELITY",
    "CONTINUITY",
    "EMOTIONAL_FIDELITY",
    "CINEMATIC_QUALITY"
  ],
  "postGeneration": {
    "validationRequired": true,
    "compareAgainstSceneTruthPacket": true,
    "materialFailureBlocksAcceptance": true,
    "providerSuccessIsAcceptance": false,
    "photorealismAloneIsAcceptance": false,
    "unknownMayBePromotedToRecordedTruth": false,
    "humanVisibleComparisonRequiredForIdentityAndEnvironment": true,
    "surgicalRegenerationPreferred": true
  },
  "shotAcceptanceReceipt": {
    "requiredFields": [
      "shotId",
      "sceneId",
      "candidateAssetKey",
      "sceneTruthPacketKey",
      "provenanceKeys",
      "failureCodes",
      "qualityDimensions",
      "continuityReceiptKey",
      "humanVisibleEvidenceKeys",
      "reviewState",
      "accepted"
    ],
    "acceptedRequiresZeroMaterialFailureCodes": true,
    "acceptedRequiresHumanVisibleEvidenceForIdentifiablePeople": true,
    "acceptedRequiresContinuityReceiptWhenDependent": true
  },
  "regressionCases": [
    "role-must-not-be-inferred-from-transport",
    "era-specific-eyewear-must-not-drift",
    "rural-environment-must-not-drift-urban",
    "generic-parent-likeness-must-fail",
    "unsupported-period-vehicle-must-fail",
    "exact-season-must-not-be-inferred-from-vegetation-alone",
    "exact-clock-time-must-not-be-inferred-from-daylight-alone",
    "exact-vehicle-model-must-not-be-invented-from-brand-or-class",
    "file-metadata-time-must-not-equal-capture-time-without-proof"
  ]
}
