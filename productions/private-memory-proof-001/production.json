    "privateNamesAllowedInPublicGitHub": false,
    "exactPrivateAddressesAllowed": false,
    "unconfirmedIdentityAssertionsAllowed": false,
    "publicDistribution": false
  },
  "inputState": {
    "familyStillArchive": "available-and-visually-reviewed",
    "familyReferencePages": "available-context-only-not-cinematic-source",
    "jointFamilyStoryTranscript": "available-editing-guide-only",
    "originalJointStoryAudio": "pending-source-availability",
    "familyObjectReference": "available",
    "multiGenerationReference": "available",
    "ruralFamilyReference": "available",
    "homeMemoryDisplayReference": "available",
    "additionalUploads": "in-progress"
  },
  "realArchiveAnchors": [
    {
      "sourceKey": "lake-boat-dog-memory",
      "class": "archival-still",
      "use": "open with a vivid ordinary-life memory; water, boat, person and companion animal"
    },
    {
      "sourceKey": "family-watch-object",
      "class": "archival-object",
      "use": "show how an ordinary physical object carries family history across generations"
    },
    {
      "sourceKey": "rural-tractor-child-memory",
      "class": "archival-still",
      "use": "connect rural/farm identity to a younger generation without inventing date or location"
    },
    {
      "sourceKey": "graduation-next-generation",
      "class": "archival-still",
      "use": "show family continuity moving forward into the next generation"
    },
    {
      "sourceKey": "home-memory-display",
      "class": "archival-environment",
      "use": "show that the family already preserves identity through pictures, art, faith, service and objects in the home"
    },
    {
      "sourceKey": "relationship-origin-oral-history",
      "class": "attributed-recollection",
      "use": "use the informal marriage-origin story as the emotional narration spine once original audio is source-verified"
    },
    {
      "sourceKey": "old-family-slides",
      "class": "attributed-recollection",
      "use": "bridge the family's older slide/projector memory practice to UrAi as a living continuation, not a replacement"
    }
  ],
  "story": {
    "storyKey": "one-family-many-threads-001",
    "treatment": "Begin with real ordinary family life, move through objects and generations, let the family's own oral history reveal meaning the photographs cannot contain, then show UrAi connecting those fragments into a navigable private memory world.",
    "truthClass": "mixed-recorded-source-and-attributed-family-recollection",
    "transcriptIsFinalQuoteAuthority": false,
    "speakerIdentityMustBeHumanVerified": true
  },
  "target": {
    "durationSeconds": 105,
    "masterAspectRatio": "16:9",
    "derivatives": [
      "9:16",
      "1:1"
    ],
    "audience": "private-family-review",
    "tone": [
      "warm",
      "cinematic",
      "specific",
      "grounded",
      "intimate",
      "generational",
      "hopeful"
    ]
  },
  "editPlan": [
    {
      "shotId": "pmp001-01",
      "kind": "archival-still",
      "sourceKey": "lake-boat-dog-memory",
      "durationSeconds": 10,
      "treatment": "Open on the real lake/boat memory with restrained motion and natural sound. No synthetic face reconstruction."
    },
    {
      "shotId": "pmp001-02",
      "kind": "archival-object",
      "sourceKey": "family-watch-object",
      "durationSeconds": 10,
      "treatment": "Macro-style crop across the real family watch while narration introduces the idea that objects outlive the stories attached to them unless somebody records why they matter."
    },
    {
      "shotId": "pmp001-03",
      "kind": "archival-still",
      "sourceKey": "rural-tractor-child-memory",
      "durationSeconds": 10,
      "treatment": "Use the real tractor image as a generational/rural anchor. Do not assert an unverified date, place or person beyond private source authority."
    },
    {
      "shotId": "pmp001-04",
      "kind": "original-voice",
      "sourceKey": "relationship-origin-oral-history",
      "durationSeconds": 20,
      "status": "blocked-until-original-audio-source-is-available-and-speaker-reviewed",
      "treatment": "Use the family's real informal marriage-origin recollection, including its humor, only after original audio verification. Do not synthesize or clone missing speech."
    },
    {
      "shotId": "pmp001-05",
      "kind": "archival-still-sequence",
      "sourceKey": "graduation-next-generation",
      "durationSeconds": 12,
      "treatment": "Move from older memories to real graduation imagery to make the generational continuity visible."
    },
    {
      "shotId": "pmp001-06",
      "kind": "archival-environment",
      "sourceKey": "home-memory-display",
      "durationSeconds": 10,
      "treatment": "Use the real home display as evidence that memory already lives in rooms, objects, portraits, art and small family arrangements."
    },
    {
      "shotId": "pmp001-07",
      "kind": "urai-runtime-capture",
      "durationSeconds": 18,
      "treatment": "Transition the real archive into exact-head UrAi capture: object, person, place, relationship, story and generation become connected memory nodes. Generated UI substitution is forbidden."
    },
    {
      "shotId": "pmp001-08",
      "kind": "end-card",
      "durationSeconds": 15,
      "treatment": "Return to real source imagery and close on the idea that this proof uses only a small fraction of the family archive. Encourage continued storytelling without implying the archive is complete."
    }
  ],
  "generationPolicy": {
    "existingProviderGeneratedAssetsPresent": true,
    "existingProviderTaskAudit": "productions/private-memory-proof-001/RUNWAY_TASK_AUDIT_20261001.md",
    "priorProviderGenerationAuthorizationProvenance": "not-established-by-this-repository-audit",
    "newPaidProviderGenerationAuthorized": false,
    "generatedIdentifiableFamilyLikenessAcceptance": "blocked-until-human-likeness-and-consent-review",
    "cinematicEnvironmentGenerationMayBeAddedLater": "bounded-authorization-required",
    "providerSpendRequiresSeparateBoundedManifest": true,
    "sceneTruthPacketRequiredBeforeGeneration": true,
    "postGenerationCanonValidationRequired": true,
    "providerSuccessIsAcceptance": false,
    "photorealismAloneIsAcceptance": false,
    "surgicalRegenerationPreferred": true,
    "sceneTruthReceiptRequiredBeforeJobsDispatch": true
  },
  "humanGates": [
    "family-likeness",
    "speaker-attribution",
    "emotional-truth",
    "autobiographical-truth",
    "privacy",
    "final-pacing",
    "private-review-acceptance",
    "public-release-separate-and-disabled"
  ],
  "acceptance": {
    "mustUseRealFamilySourceMedia": true,
    "mustUseOriginalFamilyVoiceWhenVoiceIsPresentedAsOriginal": true,
    "mustDistinguishRecollectionFromVerifiedHistoricalFact": true,
    "mustRetainPrivateSourceInDrive": true,
    "mustBindProductCaptureToExactSpatialSha": true,
    "mustNotClaimPublicRelease": true,
    "mustRetainProviderTaskReceipt": true,
    "mustNotTreatGenerationSuccessAsHumanAcceptance": true,
    "mustHaveSceneTruthPacket": true,
    "mustPassPostGenerationCanonValidation": true,
    "mustRejectMaterialFailureCodes": true,
    "mustHaveHumanVisibleIdentityEvidenceForIdentifiablePeople": true,
    "mustHaveContinuityReceiptForDependentShots": true,
    "mustRetainSceneTruthReceipt": true,
    "mustBindRenderReceiptToSceneTruthReceipt": true,
    "mustRejectMissingOrMalformedSceneTruthReceipt": true,
    "mustVerifySceneTruthReceiptHmac": true,
    "mustRejectExpiredSceneTruthReceipt": true,
    "mustRejectCrossProjectSceneTruthReceipt": true,
    "mustRejectCrossDigestSceneTruthReceipt": true,
    "mustRejectSceneTruthReceiptReplayToDifferentRender": true
  },
  "currentMediaReview": {
    "state": "QUALITY_FAILED_REPAIR_REQUIRED",
    "source": "private-human-review-20261001",
    "knownFailureClasses": [
      "IDENTITY_FAIL",
      "ROLE_FAIL",
      "EYEWEAR_FAIL",
      "VEHICLE_FAIL",
      "ENVIRONMENT_FAIL",
      "GEOGRAPHY_FAIL",
      "GENERICIZATION_FAIL"
    ],
    "existingProviderSuccessMayBePromotedToAccepted": false,
    "failedShotsMustBeRevalidatedAgainstPrivateCanon": true,
    "privateCorrectionsRemainOutsidePublicRepository": true
  },
  "executionAuthority": {
    "jobsBridge": "urai-jobs/studio.render.video",
    "sceneTruthReceiptPrefix": "str_",
    "rawPrivateCanonMayEnterJobsPayload": false,
    "opaqueReceiptOnly": true,
    "sceneTruthReceiptAuthority": "issueAcceptedSceneTruthReceipt",
    "sceneTruthReceiptSecret": "URAI_SCENE_TRUTH_RECEIPT_HMAC",
    "sceneTruthReceiptTtlMinutes": 15,
    "sceneTruthReceiptCryptographicBinding": [
      "receiptId",
      "projectId",
      "sceneTruthDigest",
      "expiry"
    ],
    "sceneTruthReceiptReplayPolicy": "first-use binds exact Jobs request fingerprint; identical retry may deduplicate; different request must conflict",
    "genericJobsCreateBypassAllowed": false,
    "privateCanonEmbeddedInJobsPayload": false
  }
