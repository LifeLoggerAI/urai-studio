{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urai:generic-world-spec:1.0.0",
  "title": "UrAi Generic World Source Specification",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "batch", "title", "truthClassification", "status", "coordinateConvention", "historicalClaim", "composition", "modularKit", "materialDefinitions", "navigation", "personalization", "performanceProfiles", "provenance", "productionStatus", "integrationBoundary"],
  "properties": {
    "schemaVersion": {"const": "urai-generic-world-spec/1.0.0"},
    "id": {"type": "string", "pattern": "^gw-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "batch": {"enum": [1, 2]},
    "title": {"type": "string", "minLength": 8},
    "truthClassification": {"const": "GENERIC"},
    "status": {"const": "SPECIFIED"},
    "coordinateConvention": {
      "type": "object", "required": ["units", "handedness", "up", "assetFront", "cameraForward", "origin"],
      "properties": {"units": {"const": "meters"}, "handedness": {"const": "right-handed"}, "up": {"const": "+Y"}, "assetFront": {"const": "+Z"}, "cameraForward": {"const": "-Z"}, "origin": {"const": "primary-zone floor center"}}
    },
    "historicalClaim": {"type": "object", "required": ["isHistoricalReconstruction", "isUniversalEraOrRegionClaim"], "properties": {"isHistoricalReconstruction": {"const": false}, "isUniversalEraOrRegionClaim": {"const": false}}},
    "composition": {
      "type": "object", "required": ["zones", "openings", "furniture", "dressingRules"],
      "properties": {
        "zones": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "dimensionsMeters", "originMeters", "kind", "purpose"], "properties": {"dimensionsMeters": {"$ref": "#/$defs/dimensions"}, "originMeters": {"$ref": "#/$defs/vector3"}, "kind": {"enum": ["interior", "exterior", "covered-exterior"]}}},
        "openings": {"type": "array", "minItems": 1},
        "furniture": {"type": "array", "items": {"type": "object", "required": ["id", "zone", "positionMeters", "dimensionsMeters", "materialIntent", "collidable"], "properties": {"dimensionsMeters": {"$ref": "#/$defs/dimensions"}, "positionMeters": {"$ref": "#/$defs/vector3"}}}},
        "dressingRules": {"type": "object", "required": ["empty", "light", "rich", "people"]}
      }
    },
    "modularKit": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "version", "role", "description", "dimensionsMeters", "materialIntent", "source", "rights", "output", "truthClassification", "status"],
        "properties": {"id": {"type": "string", "pattern": "^kit:[a-z0-9-]+:v[0-9]+$"}, "version": {"type": "string"}, "dimensionsMeters": {"$ref": "#/$defs/dimensions"}, "truthClassification": {"const": "GENERIC"}, "status": {"const": "SPECIFIED"}, "source": {"type": "object"}, "rights": {"type": "object"}, "output": {"type": "object", "required": ["format"], "properties": {"format": {"const": "GLB"}}}}}
    },
    "productionStatus": {
      "type": "object", "required": ["runtimeIntegrated", "productionDeployed", "spatialAccepted", "independentlyApproved", "xrCertified"],
      "properties": {"runtimeIntegrated": {"const": false}, "productionDeployed": {"const": false}, "spatialAccepted": {"const": false}, "independentlyApproved": {"const": false}, "xrCertified": {"const": false}}
    },
    "integrationBoundary": {"type": "object", "required": ["activeSpatialCandidateModified", "runtimeAssetBinding", "releaseCandidate"], "properties": {"activeSpatialCandidateModified": {"const": false}, "runtimeAssetBinding": {"type": "null"}, "releaseCandidate": {"type": "null"}}}
  },
  "$defs": {
    "dimensions": {"type": "object", "required": ["width", "height", "depth"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "depth": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
  }
}
