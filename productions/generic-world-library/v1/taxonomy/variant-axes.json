      "when": {
        "variant.furniturePackage": "personal-substitution-governed"
      }
    },
    {
      "requires": "new collision/navmesh and reachable-exit QA",
      "when": {
        "variant.navigation": "alternate-geometry-reviewed"
      }
    }
