rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function ownsExisting() { return isSignedIn() && resource.data.uid == request.auth.uid; }
    function ownsIncoming() { return isSignedIn() && request.resource.data.uid == request.auth.uid; }

    function membershipId(studioId) {
      return request.auth.uid + "_" + studioId;
    }

    function membershipPath(studioId) {
      return /databases/$(database)/documents/memberships/$(membershipId(studioId));
    }

    function membershipIsActive(studioId) {
      return isSignedIn()
        && exists(membershipPath(studioId))
        && get(membershipPath(studioId)).data.uid == request.auth.uid
        && get(membershipPath(studioId)).data.studioId == studioId
        && get(membershipPath(studioId)).data.status == "active";
    }

    function roleIsOneOf(studioId, roles) {
      return membershipIsActive(studioId)
        && get(membershipPath(studioId)).data.role in roles;
    }

    function canView(studioId) {
      return membershipIsActive(studioId);
    }

    function canEdit(studioId) {
      return roleIsOneOf(studioId, ["owner", "admin", "editor"]);
    }

    function canAdminister(studioId) {
      return roleIsOneOf(studioId, ["owner", "admin"]);
    }

    function isOwner(studioId) {
      return roleIsOneOf(studioId, ["owner"]);
    }

    function incomingStudioId() {
      return request.resource.data.studioId;
    }

    function hasIncomingStudioId() {
      return request.resource.data.studioId is string;
    }

    function studioIdIsImmutable() {
      return hasIncomingStudioId()
        && resource.data.studioId is string
        && request.resource.data.studioId == resource.data.studioId;
    }

    match /studios/{studioId} {
      allow read: if canView(studioId);
      // Studio creation and the initial owner membership must be one trusted,
      // server-authorized operation. Firebase Admin bypasses client rules.
      allow create: if false;
      allow update: if canAdminister(studioId);
      allow delete: if isOwner(studioId);
    }

    match /memberships/{membershipDocumentId} {
      allow read: if isSignedIn()
        && (
          (resource.data.uid == request.auth.uid
            && membershipDocumentId == request.auth.uid + "_" + resource.data.studioId)
          || canAdminister(resource.data.studioId)
        );
      // Membership grants, role transitions, suspension and revocation are
      // server-owned. A client must never self-assign owner/admin membership.
      allow create, update, delete: if false;
    }

    match /clipRequests/{id} {
      allow read: if canView(resource.data.studioId);
      allow create: if hasIncomingStudioId() && canEdit(incomingStudioId());
      allow update: if studioIdIsImmutable() && canEdit(resource.data.studioId);
      allow delete: if canAdminister(resource.data.studioId);
    }

    match /jobs/{id} {
      allow read: if canView(resource.data.studioId);
      allow create: if hasIncomingStudioId() && canEdit(incomingStudioId());
      allow update: if studioIdIsImmutable() && canEdit(resource.data.studioId);
      allow delete: if canAdminister(resource.data.studioId);
    }

    // Worker lifecycle records are trusted-server state. Clients may inspect
    // records for their active Studio but cannot impersonate a worker.
    match /jobRuns/{id} {
      allow read: if canView(resource.data.studioId);
      allow create, update, delete: if false;
    }

    match /assets/{id} {
      allow read: if canView(resource.data.studioId);
      allow create: if hasIncomingStudioId() && canEdit(incomingStudioId());
      allow update: if studioIdIsImmutable() && canEdit(resource.data.studioId);
      allow delete: if canAdminister(resource.data.studioId);
    }

    match /outputs/{id} {
      allow read: if canView(resource.data.studioId);
      allow create, update, delete: if false;
    }

    match /deadLetters/{id} {
      allow read: if canAdminister(resource.data.studioId);
      allow create, update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if canAdminister(resource.data.studioId);
      allow create, update, delete: if false;
    }

    match /users/{uid} {
      allow read, create, update: if isSignedIn() && uid == request.auth.uid;
      allow delete: if false;
    }

    // Legacy client-owned Studio documents remain uid-scoped only while the
    // canonical tenant migration is incomplete. No new role model is added here.
    match /studioProjects/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /studioScenes/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /studioAssets/{id} {
      allow read: if (resource.data.isPublic == true) || ownsExisting();
      allow create: if ownsIncoming();
      allow update, delete: if ownsExisting();
    }

    match /assetJobs/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /assetCollections/{id} {
      allow read: if (resource.data.isPublic == true) || ownsExisting();
      allow create: if ownsIncoming();
      allow update, delete: if ownsExisting();
    }

    match /studioScrolls/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /narratorScripts/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /subtitles/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /voiceoverJobs/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /exportJobs/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /studioEvents/{id} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update, delete: if false;
    }

    match /catalogs/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /remoteConfigMirror/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /xrSessions/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /vrSessions/{id} {
      allow read, update, delete: if ownsExisting();
      allow create: if ownsIncoming();
    }

    // Runtime system-contract collections are written only by trusted server/API routes.
    match /studioBriefs/{id} {
      allow read, write: if false;
    }

    match /studioJobs/{id} {
      allow read, write: if false;
    }

    match /studioExports/{id} {
      allow read, write: if false;
    }

    // Public forms are written only through trusted server routes using Firebase Admin.
    match /waitlist/{id} {
      allow read, write: if false;
    }

    match /contactMessages/{id} {
      allow read, write: if false;
    }

    match /contactRequests/{id} {
      allow read, write: if false;
    }

    match /projectRequests/{id} {
      allow read, write: if false;
    }

    match /integrationRequests/{id} {
      allow read, write: if false;
    }
  }
}
