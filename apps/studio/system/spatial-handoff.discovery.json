{
  "service": "urai-studio",
  "consumerSystem": "urai-spatial",
  "contractVersion": "0.1.0",
  "wireContract": "urai-spatial/0.1.0",
  "route": "/api/system/spatial-handoff",
  "exportRoute": "/api/studio/exports",
  "typescriptContract": "apps/studio/lib/studio-spatial-handoff.ts",
  "openapiFragment": "apps/studio/system/spatial-handoff.openapi.json",
  "requiredExportField": "spatialHandoff",
  "defaultStatus": "blocked",
  "defaultRenderer": "fallback_cards",
  "trustedReleaseAuthorityRequired": true,
  "liveIntegrationClaimed": false,
  "requiredWireFields": [
    "contractVersion",
    "producer",
    "consumer",
    "exportId",
    "projectId",
    "tenantId",
    "createdAt",
    "runtimeTargets",
    "sceneManifest",
    "assetManifest",
    "consentReceipt",
    "safetyBoundaries",
    "releaseEvidence"
  ],
  "modelAssetContract": {
    "kind": "mesh",
    "glbMimeType": "model/gltf-binary",
    "gltfMimeType": "model/gltf+json"
  },
  "guardHelpers": [
    "emitStudioSpatialExport",
    "createBlockedStudioSpatialHandoff",
    "validateStudioSpatialExport",
    "validateStudioSpatialManifest",
    "listBlockedStudioSpatialClaims",
    "isStudioSpatialManifestReleaseSafe"
  ],
  "testFiles": [
    "apps/studio/tests/studio-spatial-handoff.test.mjs",
    "apps/studio/tests/export-handoff.test.mjs",
    "apps/studio/tests/spatial-handoff-openapi.test.mjs"
  ]
}
