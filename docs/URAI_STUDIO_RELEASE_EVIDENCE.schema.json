{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urai.studio/schemas/release-evidence.schema.json",
  "title": "URAI Studio Release Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "commitSha",
    "recordedAt",
    "environment",
    "gates"
  ],
  "properties": {
    "repository": {
      "const": "LifeLoggerAI/urai-studio"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "ci",
        "staging",
        "production"
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "lint",
        "typecheck",
        "tests",
        "appBuild",
        "functionsBuild",
        "doneDoneGuard",
        "releaseCheck",
        "providerReadiness",
        "binaryArtifacts",
        "smoke"
      ],
      "properties": {
        "install": {
          "$ref": "#/$defs/gate"
        },
        "lint": {
          "$ref": "#/$defs/gate"
        },
        "typecheck": {
          "$ref": "#/$defs/gate"
        },
        "tests": {
          "$ref": "#/$defs/gate"
        },
        "appBuild": {
          "$ref": "#/$defs/gate"
        },
        "functionsBuild": {
          "$ref": "#/$defs/gate"
        },
        "doneDoneGuard": {
          "$ref": "#/$defs/gate"
        },
        "releaseCheck": {
          "$ref": "#/$defs/gate"
        },
        "providerReadiness": {
          "$ref": "#/$defs/providerReadinessGate"
        },
        "binaryArtifacts": {
          "$ref": "#/$defs/binaryArtifactsGate"
        },
        "smoke": {
          "$ref": "#/$defs/gate"
        },
        "deploy": {
          "$ref": "#/$defs/gate"
        },
        "liveSmoke": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not_run"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "nonPassEvidence": {
      "type": "string",
      "minLength": 1
    },
    "providerReadinessEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityMode",
        "projectId",
        "principal",
        "observedAt",
        "checks",
        "evidenceRefs"
      ],
      "properties": {
        "identityMode": {
          "type": "string",
          "enum": [
            "workload_identity_federation",
            "google_managed_runtime_identity"
          ]
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        },
        "principal": {
          "type": "string",
          "minLength": 3
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tokenAcquired",
            "firebaseAdmin",
            "firestoreRead",
            "firestoreWrite",
            "storageRead",
            "storageWrite",
            "functionsHealth"
          ],
          "properties": {
            "tokenAcquired": { "const": true },
            "firebaseAdmin": { "const": true },
            "firestoreRead": { "const": true },
            "firestoreWrite": { "const": true },
            "storageRead": { "const": true },
            "storageWrite": { "const": true },
            "functionsHealth": { "const": true }
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "providerReadinessGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not_run"
          ]
        },
        "evidence": {},
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pass" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "$ref": "#/$defs/providerReadinessEvidence" } }
          },
          "else": {
            "properties": { "evidence": { "$ref": "#/$defs/nonPassEvidence" } }
          }
        }
      ]
    },
    "binaryArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mimeType",
        "sha256",
        "sizeBytes",
        "usable",
        "sourceJobId",
        "artifactRef",
        "probe"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["image", "audio", "video", "model", "archive", "other"]
        },
        "mimeType": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "usable": { "const": true },
        "playable": { "type": "boolean" },
        "sourceJobId": {
          "type": "string",
          "pattern": "^(?:github-actions|cloud-build|firebase|studio-job)://[^\\s]+$"
        },
        "artifactRef": {
          "type": "string",
          "pattern": "^(?:https|gs|artifact)://[^\\s]+$"
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "result", "observedAt"],
          "properties": {
            "tool": { "type": "string", "minLength": 1 },
            "result": { "const": "pass" },
            "observedAt": { "type": "string", "format": "date-time" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["audio", "video"] } },
            "required": ["kind"]
          },
          "then": {
            "required": ["playable"],
            "properties": { "playable": { "const": true } }
          }
        }
      ]
    },
    "binaryArtifactsEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binaryArtifact" }
        }
      }
    },
    "binaryArtifactsGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "blocked", "not_run"]
        },
        "evidence": {},
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pass" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "$ref": "#/$defs/binaryArtifactsEvidence" } }
          },
          "else": {
            "properties": { "evidence": { "$ref": "#/$defs/nonPassEvidence" } }
          }
        }
      ]
    }
  },
  "description": "URAI Studio release evidence record for one exact head and environment. Source checks, provider readiness, binary artifact truth, deployment, and live verification are separate gates and must never be inferred from one another."
}
