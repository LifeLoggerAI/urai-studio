{
  "hosting": {
    "source": "apps/studio",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": []
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "pnpm --dir functions install --frozen-lockfile",
      "pnpm --dir functions build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "hub": {
      "host": "127.0.0.1",
      "port": 4401
    },
    "ui": {
      "host": "127.0.0.1",
      "port": 4001
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4501
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5002
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5003
    },
    "singleProjectMode": true,
    "eventarc": {
      "host": "127.0.0.1",
      "port": 9299
    }
  }
}
